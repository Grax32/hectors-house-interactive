{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./scripts/*"],
      "scripts/*": ["./scripts/*"]
    }
  },
  "include": ["scripts/**/*.ts"]
}
